    {
      "name": "认证 / Auth",
      "description": "注册、登录、个人信息、修改昵称与密码",
      "item": [
        {
          "name": "登录 Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "使用 admin/admin123 登录（管理员）。成功后自动将 token 写入集合变量 {{token}}，无需手工复制。",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"admin123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// 登录成功后自动把 token 写入集合变量，后续接口直接复用",
                  "const res = pm.response.json();",
                  "if (res && res.code === 0 && res.data && res.data.token) {",
                  "    pm.collectionVariables.set('token', res.data.token);",
                  "    console.log('token 已写入集合变量，可直接调用其它接口');",
                  "}"
                ]
              }
            }
          ]
        },
