{
  "name": "ve",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n mock,vite -c yellow,cyan \"npm run mock\" \"vite\"",
    "mock": "node mock-server.cjs",
    "start": "node mock-server.cjs",
    "build": "vite build",
    "build:front": "vite build",
    "build:admin": "vite build --config vite-admin.config.js",
    "preview": "vite preview",
    "lint": "eslint src/ --fix",
    "format": "prettier --write \"src/**/*.{js,vue,css}\"",
    "lint:check": "eslint src/",
    "format:check": "prettier --check \"src/**/*.{js,vue,css}\"",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "release": "standard-version",
    "release:minor": "standard-version --release-as minor",
    "release:major": "standard-version --release-as major",
    "prepare": "husky"
  },
  "dependencies": {
    "@vee-validate/zod": "^4.15.1",
    "axios": "^1.18.1",
    "echarts": "^6.1.0",
    "exceljs": "^4.4.0",
    "express": "^4.21.0",
    "express-rate-limit": "^8.5.2",
    "morgan": "^1.11.0",
    "multer": "^2.2.0",
    "pinia": "^3.0.4",
    "vee-validate": "^4.15.1",
    "vue": "^3.5.38",
    "vue-echarts": "^8.0.1",
    "vue-i18n": "^11.4.6",
    "vue-router": "^4.6.4",
    "xlsx": "^0.18.5",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.0",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitest/coverage-v8": "^3.2.6",
    "@vue/test-utils": "^2.4.11",
    "concurrently": "^10.0.3",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-vue": "^10.9.2",
    "happy-dom": "^20.10.6",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "json-server": "^0.17.4",
    "lint-staged": "^17.0.8",
    "prettier": "^3.9.4",
    "standard-version": "^9.5.0",
    "vite": "^8.1.0",
    "vite-plugin-compression": "^0.5.1",
    "vitest": "^3.2.4"
  },
  "lint-staged": {
    "*.{js,vue,css}": [
      "prettier --write",
      "eslint --fix"
    ]
  }
}
